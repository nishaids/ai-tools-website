# Gemini API Keys (multiple keys rotate automatically when quotas run out)
# Get keys from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY_1=your_first_api_key_here
GEMINI_API_KEY_2=your_second_api_key_here
GEMINI_API_KEY_3=your_third_api_key_here
# Single-key fallback (used only if none of the numbered keys are set)
# GEMINI_API_KEY=your_api_key_here

# Optional: Groq fallback provider — activates only when ALL Gemini keys and
# models are exhausted. Get a key from https://console.groq.com/keys
# GROQ_API_KEY=your_groq_key_here

# Optional: durable rate limiting via Upstash Redis (recommended on Vercel —
# the default in-memory limiter resets on serverless cold starts).
# Both must be set; auto-selected when present. https://console.upstash.com
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here
